<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_samra_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.samra.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Clienteling" name="samra_clienteling">
                    <group>
                        <group string="VIP &amp; Dates">
                            <field name="x_vip_tier" widget="badge"
                                   decoration-info="x_vip_tier == 'vip'"
                                   decoration-success="x_vip_tier == 'vvip'"/>
                            <field name="x_vip_tier_manual"/>
                            <field name="x_anniversary"/>
                            <field name="x_birthday"/>
                            <field name="x_nationality_id"/>
                        </group>
                        <group string="Preferences">
                            <field name="x_gold_colour_pref"/>
                            <field name="x_jewellery_category_pref"/>
                            <field name="x_collection_pref"/>
                            <field name="x_size_pref"/>
                            <field name="x_diamond_spec_pref"/>
                            <field name="x_gemstone_pref"/>
                            <field name="x_style_pref"/>
                            <field name="x_budget_pref"/>
                        </group>
                    </group>
                    <group>
                        <group string="Marketing Consent">
                            <field name="x_whatsapp_consent"/>
                            <field name="x_sms_consent"/>
                        </group>
                        <group string="Purchase Analytics">
                            <field name="x_lifetime_value"/>
                            <field name="x_purchase_frequency"/>
                            <field name="x_last_purchase_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_list_samra_inherit" model="ir.ui.view">
        <field name="name">res.partner.list.samra.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="x_vip_tier" optional="show"/>
                <field name="x_lifetime_value" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!--
        Three ways in, on purpose. base.view_partner_form ships an empty
        oe_button_box, so a lone stat button sits in an otherwise bare strip
        and is easy to miss. The header button is the one an associate will
        actually find; the Action-menu entry covers people who work from the
        list.
    -->
    <record id="view_partner_form_samra_button" model="ir.ui.view">
        <field name="name">res.partner.form.samra.button</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- The base form has no header of its own, so this adds one. -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button type="object"
                            name="action_open_samra_profile"
                            string="Customer 360"
                            class="btn-primary"
                            invisible="not id"/>
                </header>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object"
                        name="action_open_samra_profile"
                        class="oe_stat_button"
                        icon="fa-diamond"
                        string="Customer 360"
                        invisible="not id"/>
            </xpath>
        </field>
    </record>

    <!-- Also under the Action cog, from both the form and the list. -->
    <record id="action_samra_open_profile" model="ir.actions.server">
        <field name="name">Customer 360</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form,list</field>
        <field name="state">code</field>
        <field name="code">
if records:
    action = records[0].action_open_samra_profile()
        </field>
    </record>

</odoo>
