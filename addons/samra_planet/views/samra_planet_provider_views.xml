<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_samra_planet_provider_form" model="ir.ui.view">
        <field name="name">samra.planet.provider.form</field>
        <field name="model">samra.planet.provider</field>
        <field name="arch" type="xml">
            <form string="Planet Provider">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="provider_type"/>
                            <field name="merchant_id" invisible="provider_type != 'rest'"/>
                            <field name="endpoint" invisible="provider_type != 'rest'"
                                   required="provider_type == 'rest'"/>
                            <field name="auth_header" invisible="provider_type != 'rest'"/>
                            <field name="auth_prefix" invisible="provider_type != 'rest'"/>
                            <field name="api_key" password="True"
                                   invisible="provider_type != 'rest'"/>
                            <field name="timeout" invisible="provider_type != 'rest'"/>
                            <field name="active"/>
                        </group>
                        <group string="Reading the answer" invisible="provider_type != 'rest'">
                            <field name="status_path"/>
                            <field name="tag_path"/>
                            <field name="qr_path"/>
                            <field name="refundable_vat_path"/>
                            <field name="approved_values"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_samra_planet_provider_list" model="ir.ui.view">
        <field name="name">samra.planet.provider.list</field>
        <field name="model">samra.planet.provider</field>
        <field name="arch" type="xml">
            <list string="Planet Providers">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider_type"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_samra_planet_provider" model="ir.actions.act_window">
        <field name="name">Planet Providers</field>
        <field name="res_model">samra.planet.provider</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
