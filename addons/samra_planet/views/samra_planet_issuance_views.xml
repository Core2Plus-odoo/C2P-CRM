<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_samra_planet_issuance_list" model="ir.ui.view">
        <field name="name">samra.planet.issuance.list</field>
        <field name="model">samra.planet.issuance</field>
        <field name="arch" type="xml">
            <list string="Tax-Free Issuances" create="false" delete="false"
                  decoration-success="status == 'approved'"
                  decoration-danger="status == 'declined'"
                  decoration-muted="status == 'error'">
                <field name="create_date" string="Issued"/>
                <field name="order_ref"/>
                <field name="partner_id"/>
                <field name="status"/>
                <field name="tag_number"/>
                <field name="refundable_vat" optional="show"/>
                <field name="provider_id" optional="hide"/>
                <field name="detail" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_samra_planet_issuance_form" model="ir.ui.view">
        <field name="name">samra.planet.issuance.form</field>
        <field name="model">samra.planet.issuance</field>
        <field name="arch" type="xml">
            <form string="Tax-Free Issuance" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="order_ref"/>
                            <field name="partner_id"/>
                            <field name="status"/>
                            <field name="tag_number"/>
                            <field name="qr_code_string"/>
                            <field name="refundable_vat"/>
                        </group>
                        <group>
                            <field name="provider_id"/>
                            <field name="detail"/>
                        </group>
                    </group>
                    <notebook groups="samra_planet.group_planet_manager">
                        <page string="Sent"><field name="request_payload" nolabel="1"/></page>
                        <page string="Received"><field name="response_payload" nolabel="1"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_samra_planet_issuance" model="ir.actions.act_window">
        <field name="name">Tax-Free Issuances</field>
        <field name="res_model">samra.planet.issuance</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
