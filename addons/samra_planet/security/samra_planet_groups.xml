<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="res_groups_privilege_planet" model="res.groups.privilege">
            <field name="name">Planet Tax-Free</field>
            <field name="category_id" ref="base.module_category_sales_sales"/>
        </record>

        <record id="group_planet_user" model="res.groups">
            <field name="name">Tax-Free Visible</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_planet"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_planet_manager" model="res.groups">
            <field name="name">Tax-Free Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_planet"/>
            <field name="implied_ids" eval="[(4, ref('samra_planet.group_planet_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
