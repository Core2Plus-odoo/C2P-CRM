<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Everyone who sells needs to read the rate; only managers set it.
         A wrong rate misprices the whole shelf in one keystroke, so write
         access is deliberately narrower than read. -->

    <record id="access_samra_gold_rate_user" model="ir.model.access">
        <field name="name">samra.gold.rate.user</field>
        <field name="model_id" ref="model_samra_gold_rate"/>
        <field name="group_id" ref="base.group_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_samra_gold_rate_manager" model="ir.model.access">
        <field name="name">samra.gold.rate.manager</field>
        <field name="model_id" ref="model_samra_gold_rate"/>
        <field name="group_id" ref="sales_team.group_sale_manager"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>
