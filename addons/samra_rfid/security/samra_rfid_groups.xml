<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="res_groups_privilege_rfid" model="res.groups.privilege">
            <field name="name">RFID Sync</field>
            <field name="category_id" ref="base.module_category_supply_chain"/>
        </record>

        <record id="group_rfid_user" model="res.groups">
            <field name="name">Gap Analysis Visible</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_rfid"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_rfid_manager" model="res.groups">
            <field name="name">RFID Manager</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_rfid"/>
            <field name="implied_ids" eval="[(4, ref('samra_rfid.group_rfid_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
