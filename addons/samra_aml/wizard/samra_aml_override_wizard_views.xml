<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_samra_aml_override_wizard_form" model="ir.ui.view">
        <field name="name">samra.aml.override.wizard.form</field>
        <field name="model">samra.aml.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Record AML Override">
                <div class="alert alert-warning" role="alert">
                    This permits a sale to a customer that screening has
                    flagged. It is recorded against your name, cannot be
                    deleted, and lapses on its own.
                </div>
                <group>
                    <field name="partner_id"/>
                    <field name="status"/>
                    <field name="matched_list"/>
                    <field name="screening_id"/>
                    <field name="valid_days"/>
                </group>
                <group string="Reason">
                    <field name="reason" nolabel="1" colspan="2"
                           placeholder="What was checked, and why this customer is not the person on the list."/>
                </group>
                <footer>
                    <button name="action_record" type="object" string="Record Override"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
