        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_samra_aml_screening_manager" model="ir.model.access">
        <field name="name">samra.aml.screening.manager</field>
        <field name="model_id" ref="model_samra_aml_screening"/>
        <field name="group_id" ref="samra_aml.group_aml_manager"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_samra_aml_override_user" model="ir.model.access">
        <field name="name">samra.aml.override.user</field>
        <field name="model_id" ref="model_samra_aml_override"/>
        <field name="group_id" ref="samra_aml.group_aml_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_samra_aml_override_manager" model="ir.model.access">
        <field name="name">samra.aml.override.manager</field>
        <field name="model_id" ref="model_samra_aml_override"/>
        <field name="group_id" ref="samra_aml.group_aml_manager"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_samra_aml_override_wizard" model="ir.model.access">
        <field name="name">samra.aml.override.wizard</field>
        <field name="model_id" ref="model_samra_aml_override_wizard"/>
        <field name="group_id" ref="samra_aml.group_aml_manager"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
