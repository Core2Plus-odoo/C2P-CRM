# Copy to .env and fill in real values. .env is gitignored -- keep it that way.
#
# Generate an API key in Odoo:
#   Settings -> Users -> <user> -> Account Security -> New API Key
#
# Use a dedicated integration user with a restricted access group, NOT admin.
# A demo that authenticates as admin invites the question "so any integration
# has full control of our database?" -- the wrong question to answer live.

ODOO_URL=https://core2plus-odoo-c2p-crm.odoo.com
ODOO_DB=core2plus-odoo-c2p-crm-main-37645505
ODOO_LOGIN=integration
ODOO_API_KEY=

# Optional
ODOO_TIMEOUT=30
# DEMO_PARTNER_EMAIL=customer@example.com
# DEMO_PARTNER_ID=17
